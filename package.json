{
  "name": "footwear-hero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5181 --strictPort",
    "build": "node functions/scripts/sync-shared.mjs && vite build && node scripts/make-sw.mjs",
    "build:e2e": "node functions/scripts/sync-shared.mjs && vite build --mode e2e --outDir dist-e2e && node scripts/make-sw.mjs dist-e2e",
    "e2e": "node scripts/emulators.mjs exec \"node scripts/e2e.mjs\"",
    "preview": "vite preview",
    "pretest": "node functions/scripts/sync-shared.mjs",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:emulator": "node scripts/emulators.mjs exec \"node --test --test-concurrency=1 tests/emulator/*.test.js\"",
    "emulators": "node scripts/emulators.mjs start",
    "migrate": "node functions/scripts/migrate.mjs",
    "migrate:warehouses": "node functions/scripts/migrate-warehouses.mjs",
    "migrate:sales": "node functions/scripts/migrate-sales.mjs",
    "migrate:accounting": "node functions/scripts/migrate-accounting.mjs",
    "backup": "node scripts/backup-firestore.mjs",
    "restore": "node scripts/restore-firestore.mjs",
    "lint": "eslint .",
    "typecheck": "node functions/scripts/sync-shared.mjs && tsc -p tsconfig.json",
    "secrets": "node scripts/check-secrets.mjs",
    "check": "npm run secrets && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@vercel/blob": "2.9.0",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "sharp": "0.35.5",
    "three": "^0.170.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "firebase-tools": "15.34.0",
    "globals": "17.13.0",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.7"
    },
    "jwks-rsa": "3.2.2",
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
