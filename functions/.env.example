# Cloud Functions configuration. Copy to functions/.env.italianshoes (git-ignored) before deploying.
# These are configuration values, not secrets. Real secrets use `firebase functions:secrets:set`.

# Email address of the store owner. The account with this VERIFIED email can claim the Owner role
# once, from the admin sign-in page, while the store has no Owner yet.
OWNER_EMAIL=

# Turn on only after App Check is set up and monitored (see SECURITY.md).
APP_CHECK_ENFORCE=false
