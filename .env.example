# Copy to .env.local for local development. .env.local is git-ignored.
# Anything starting with VITE_ is built into the PUBLIC website: never put a secret there.

# ── Browser (public) ──────────────────────────────────────────────────────────
# Development talks to the local Firebase emulators by default.
VITE_FIREBASE_TARGET=emulators
# reCAPTCHA Enterprise site key for Firebase App Check (public). Leave empty; not enforced on Vercel.
VITE_APPCHECK_SITE_KEY=

# ── Server only: set these in Vercel → Project → Settings → Environment Variables ──
# NEVER commit real values and NEVER prefix them with VITE_. Names only are listed here.
#   FIREBASE_PROJECT_ID     e.g. italianshoes
#   FIREBASE_CLIENT_EMAIL   from a Firebase service-account key (client_email)
#   FIREBASE_PRIVATE_KEY    from the same key (private_key); keep the \n sequences or paste it multi-line
#   OWNER_EMAIL             the store owner's email (used once, for first-time Owner setup)
#   BLOB_READ_WRITE_TOKEN   added automatically when you connect a Vercel Blob store to the project
