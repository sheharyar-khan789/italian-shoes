# Copy to .env.local for local overrides. .env.local is git-ignored.
# Nothing secret belongs in VITE_* variables: they are built into the public website.

# Development talks to the local Firebase emulators by default.
# Set to "production" ONLY to point `npm run dev` at the live italianshoes project.
VITE_FIREBASE_TARGET=emulators

# reCAPTCHA Enterprise site key for Firebase App Check (public). Leave empty until created.
# Turning this on also needs the CSP update described in SECURITY.md.
VITE_APPCHECK_SITE_KEY=
