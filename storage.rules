rules_version = '2';

// Cloud Storage security rules. DENY BY DEFAULT.

service firebase.storage {
  match /b/{bucket}/o {

    function canUpload() {
      return request.auth != null
        && request.auth.token.staff == true
        && request.auth.token.perms is list
        && 'products.write' in request.auth.token.perms;
    }

    // Staff upload ORIGINALS here. Checked here (type, size, uploader recorded) and checked again
    // by the onProductImageUploaded function, which reads the real file contents, makes WebP
    // versions, strips metadata and deletes the original. Originals are never publicly readable.
    match /products/{productId}/uploads/{uploadId} {
      allow create: if canUpload()
        && uploadId.matches('^[A-Za-z0-9_-]{8,64}$')
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.metadata.uploadedBy == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Processed product photos: public, written only by the function.
    match /products/{productId}/images/{file} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
